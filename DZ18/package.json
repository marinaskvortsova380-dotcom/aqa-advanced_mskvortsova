{
  "name": "dz18-cypress",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cy:run:record": "npx cypress run --record"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cypress": "^15.20.1",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "stepDefinitions": "cypress/e2e"
  }
}
